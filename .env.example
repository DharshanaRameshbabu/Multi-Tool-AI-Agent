# Multi-Tool AI Agent Configuration

# Environment mode: development / production
ENVIRONMENT=development
APP_HOST=0.0.0.0
APP_PORT=8000
STREAMLIT_PORT=8501

# LLM Provider selection: groq | openai | google | mock
LLM_PROVIDER=groq

# API Keys (Provide at least one, or use 'mock' for testing without an API key)
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Model specifications
DEFAULT_MODEL=llama-3.3-70b-versatile
# Alternative models:
# Groq: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
# OpenAI: gpt-4o, gpt-4o-mini
# Google: gemini-1.5-flash, gemini-1.5-pro

# Database Settings
DATABASE_URL=sqlite:///./data/tasks.db

# Agent safety & execution limits
MAX_AGENT_ITERATIONS=10
SEARCH_MAX_RESULTS=5
CONFIRM_TASK_DELETION=true
